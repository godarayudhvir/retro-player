{
  "id": "/",
  "name": "Retro Player - High-Performance Web Emulation Station",
  "short_name": "Retro Player",
  "description": "Console-grade retro game launcher and emulator station with physical 3D cartridges, Web Audio SFX, and offline WebAssembly cores.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#0f172a",
  "categories": [
    "games",
    "entertainment",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "handle_links": "preferred",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Console Settings",
      "short_name": "Settings",
      "description": "Manage ROMs, BGM audio, and console preferences",
      "url": "./?open=settings",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Load Custom ROM",
      "short_name": "Load ROM",
      "description": "Play custom ROM from disk",
      "url": "./?open=loadRom",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/desktop-1.png",
      "sizes": "1280x870",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Retro Player 3D Cartridge Library on Desktop"
    },
    {
      "src": "screenshots/mobile-1.png",
      "sizes": "450x800",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Retro Player Handheld Console Mode"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Retro Game ROM",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "application/x-gba-rom": [".gba"],
        "application/x-nes-rom": [".nes"],
        "application/x-snes-rom": [".sfc", ".smc"],
        "application/x-n64-rom": [".z64", ".n64", ".v64"],
        "application/x-nds-rom": [".nds"],
        "application/x-genesis-rom": [".gen", ".md", ".smd"],
        "application/zip": [".zip"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+retro",
      "url": "./?rom=%s"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}

